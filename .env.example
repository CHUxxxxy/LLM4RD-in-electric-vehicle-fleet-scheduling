# Copy this file to .env and fill in your values. Never commit .env.

# OpenAI-compatible endpoint. Examples:
#   OpenAI:        https://api.openai.com/v1
#   Azure OpenAI:  https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
#   Local server:  http://127.0.0.1:11434/v1
LLM4RD_API_BASE=https://api.openai.com/v1

# Required. Do not share or commit this value.
LLM4RD_API_KEY=

# Chat model id served by the endpoint above
LLM4RD_MODEL=gpt-4o-mini

LLM4RD_TEMPERATURE=0.7
LLM4RD_MAX_TOKENS=4096

# Search budget (full run). Use --quick for a smoke test.
LLM4RD_ITERATIONS=10
LLM4RD_CANDIDATES=8
LLM4RD_EVAL_EPISODES=10
LLM4RD_TRAINING_STEPS=3900000
LLM4RD_SEED=42

# Simulation scale
LLM4RD_N_VEHICLES=1000
LLM4RD_N_STATIONS=1000
